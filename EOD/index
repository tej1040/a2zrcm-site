<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>GeoPro EOD Update Tracker</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{--navy:#0f2a5c;--blue:#1e6fe0;--soft:#eef4ff;--line:#d6e2fb;--ink:#14213d;--mut:#7a879f;
--ok:#1e7a3c;--okb:#e3f4e8;--wa:#9c5700;--wab:#fff1cf;--bad:#b3261e;--badb:#fde4e2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{background:#fff;color:var(--ink);font:clamp(11px,1.5vh,14px)/1.3 -apple-system,"Segoe UI",Roboto,Arial,sans-serif}
.wrap{max-width:1120px;margin:0 auto;padding:1.4vh 16px}
.dm .wrap{max-width:1560px}
#view{font-size:clamp(14px,2.1vh,21px)}
.dm .top .ttl h1{font-size:1.9em}
.top{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid var(--blue);padding-bottom:1vh;margin-bottom:1.4vh}
.logo{font-weight:800;font-size:2.3em;letter-spacing:.04em;color:var(--navy);line-height:1}
.logo b{color:var(--blue)}.logo small{display:block;font-size:.26em;letter-spacing:.5em;color:var(--mut);font-weight:600;margin-top:.3em}
.ttl{text-align:center}.ttl h1{font-size:1.6em;color:var(--navy)}.ttl span{color:var(--mut)}
.right{display:flex;gap:.6em;align-items:center}
.date{background:var(--navy);color:#fff;font-weight:700;padding:.4em .9em;border-radius:.5em}
button{font:inherit;cursor:pointer;border-radius:.5em;padding:.45em 1em;font-weight:700;border:1px solid var(--blue);background:#fff;color:var(--blue)}
button.pri{background:var(--blue);color:#fff}button:hover{opacity:.88}
/* form */
.sec{background:var(--soft);border:1px solid var(--line);border-radius:.7em;padding:1em;margin-bottom:1.2vh}
.sec h2{color:var(--navy);font-size:1.1em;margin-bottom:.6em}
.cols{display:grid;grid-template-columns:1fr 1.05fr;gap:1vw}
.fr{display:grid;gap:.4em;align-items:center;margin-bottom:.3em}
.a{grid-template-columns:70px repeat(5,54px) 1fr}.w{grid-template-columns:1.3fr repeat(4,1fr)}
.fr.h{font-size:.8em;font-weight:700;color:var(--mut);text-transform:uppercase}
.fr .l{font-weight:600}.fr .l small{display:block;color:var(--mut);font-weight:400}
input{font:inherit;width:100%;padding:.35em .4em;border:1px solid var(--line);border-radius:.4em;background:#fff;color:var(--ink)}
input:focus{outline:2px solid var(--blue);border-color:var(--blue)}
.set{display:flex;gap:1.4em;flex-wrap:wrap;align-items:center}.set label{display:flex;gap:.5em;align-items:center;font-weight:600}.set input{width:120px}
.act{display:flex;gap:.6em;justify-content:flex-end}
/* dashboard */
.dash{display:grid;grid-template-columns:2.6fr 1fr;gap:12px;align-items:start}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.card,.att{background:var(--soft);border:1px solid var(--line);border-radius:.7em;padding:.7em .8em;display:flex;flex-direction:column;gap:.35em}
.card{border-left:.3em solid var(--ok)}.card.Issue{border-left-color:#e0a100}.card.Pending{border-left-color:var(--bad)}
.card header{display:flex;justify-content:space-between;align-items:center}
.card h3,.att h3{font-size:1.02em;color:var(--navy)}
.chip{font-size:.74em;font-weight:700;padding:.1em .55em;border-radius:1em;background:var(--okb);color:var(--ok)}
.Issue .chip{background:var(--wab);color:var(--wa)}.Pending .chip{background:var(--badb);color:var(--bad)}
.big{display:flex;align-items:baseline;justify-content:space-between}
.big b{font-size:1.7em;line-height:1;color:var(--navy)}.big em{font-style:normal;color:var(--mut);margin-left:.3em;font-size:.9em}
.mtd{text-align:right;color:var(--mut);font-size:.8em}.mtd b{display:block;color:var(--blue);font-size:1.3em;line-height:1.1}
.flag{display:inline-block;font-size:.78em;font-weight:700;padding:.05em .5em;border-radius:.4em;margin-right:.3em}
.flag.p{background:var(--wab);color:var(--wa)}.flag.e{background:var(--badb);color:var(--bad)}
ul{list-style:none;padding:.4em 0 0;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:.15em}
li{display:flex;justify-content:space-between;font-size:.92em}li span:last-child{font-weight:600}
li small{color:var(--mut);font-weight:400;margin-left:.6em}li.z{color:var(--mut)}li.z span:last-child{font-weight:400}
.tpn{grid-column:1/-1}.tpn ul{flex-direction:row;gap:2em}.tpn li{flex:1}
.d{padding:.3em 0;border-bottom:1px solid var(--line)}.d>div{display:flex;justify-content:space-between;align-items:center}
.d .n{color:var(--mut);font-size:.85em;font-style:italic}.d.z{color:var(--mut)}
.pill{font-weight:700;padding:.02em .5em;border-radius:.4em;background:var(--wab);color:var(--wa);font-size:.9em}.pill.hi{background:var(--badb);color:var(--bad)}
.sum b{font-size:1.7em;color:var(--navy)}.sum span{color:var(--mut)}
.foot{display:flex;justify-content:space-between;color:var(--mut);padding-top:.3em}.foot b{color:var(--navy)}
.hint{background:var(--soft);border-left:.3em solid var(--blue);padding:.6em .9em;border-radius:.4em;margin-bottom:1.2vh;color:var(--navy)}
.a{grid-template-columns:64px 1fr}.w{grid-template-columns:1.4fr 1fr 1fr .7fr}
.wgroup{margin-top:.7em}.wgroup:first-child{margin-top:0}
.wgroup-title{font-weight:800;color:var(--navy);padding:.35em 0;border-bottom:1px solid var(--line)}
.wgroup-row{display:grid;grid-template-columns:1.4fr 1fr 1fr .7fr;gap:.4em;align-items:center;padding:.3em 0}
.wgroup-row .sub{padding-left:1em;font-weight:600}
details summary{cursor:pointer;font-weight:700;color:var(--navy)}
.more{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.5em .8em;margin-top:.8em}
.more label{font-weight:600;font-size:.88em;display:flex;flex-direction:column;gap:.2em}
.more h4{grid-column:1/-1;color:var(--mut);font-size:.8em;text-transform:uppercase;margin-top:.5em}
.tat{margin-top:12px;background:var(--soft);border:1px solid var(--line);border-radius:.7em;padding:.7em .8em;overflow-x:auto}
.tat h3{color:var(--navy);font-size:1.02em;margin-bottom:.4em}
.tg{display:grid;grid-template-columns:1.1fr repeat(7,1fr);min-width:620px}
.tg>div{padding:.32em .4em;text-align:center;border-bottom:1px solid var(--line)}
.tg .h{font-size:.74em;font-weight:700;color:var(--mut);text-transform:uppercase}
.tg .n{text-align:left;font-weight:700;color:var(--navy)}
.tg .z{color:var(--mut)}.tg .lc{font-weight:700;color:var(--navy)}
.tg .tot{background:#dbe8ff;font-weight:800;color:var(--navy);border-bottom:0;border-top:2px solid var(--blue)}
.tf{display:grid;grid-template-columns:90px repeat(7,1fr);gap:.4em;align-items:center;margin-bottom:.3em}
.tf.h{font-size:.72em;font-weight:700;color:var(--mut);text-transform:uppercase}
.hide{display:none}
body{background:radial-gradient(900px 420px at 90% -8%,#dfeaff 0,transparent 65%),radial-gradient(700px 380px at -5% 105%,#e8f1ff 0,transparent 60%),#f8faff;font-family:Inter,"Segoe UI",-apple-system,Roboto,Arial,sans-serif}
.top{border-bottom:0;background:#fff;border:1px solid var(--line);border-radius:1em;padding:.8vh 1.1em;box-shadow:0 6px 24px rgba(30,111,224,.10);position:relative}
.top::after{content:"";position:absolute;left:1em;right:1em;bottom:-1px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--navy),var(--blue),#6aa9ff)}
.ttl h1{background:linear-gradient(90deg,var(--navy),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}
.sec,.card,.att,.tat{background:#fff;border:1px solid #e1eafb;box-shadow:0 1px 2px rgba(15,42,92,.05),0 10px 26px rgba(30,111,224,.08)}
.sec h2{display:flex;align-items:center;gap:.5em}.sec h2::before{content:"";width:.28em;height:1.1em;border-radius:3px;background:var(--blue)}
.card{border-left:0;position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s}
.card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:.34em;background:var(--ok)}
.card.Issue::before{background:#f0a500}.card.Pending::before{background:var(--bad)}
.card:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(30,111,224,.16)}
.bar{height:.42em;border-radius:9px;background:#e4ecfb;overflow:hidden}.bar i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--blue),#62a6ff)}
button.pri{background:linear-gradient(135deg,var(--blue),#3a86ff);border:0;box-shadow:0 6px 16px rgba(30,111,224,.3)}
button{transition:transform .1s}button:active{transform:scale(.97)}
.dnav{display:flex;align-items:center;gap:.2em;background:var(--soft);border:1px solid var(--line);border-radius:.7em;padding:.15em}
.dnav button{border:0;background:#fff;padding:.25em .65em;font-size:1.1em}.dnav input{border:0;background:transparent;font-weight:700;color:var(--navy);width:auto}
.sync{font-size:.78em;font-weight:700;padding:.2em .7em;border-radius:1em;background:var(--okb);color:var(--ok)}.sync.wait,.sync.saving{background:var(--wab);color:var(--wa)}.sync.err{background:var(--badb);color:var(--bad)}
.empty{background:var(--wab);color:var(--wa);border-radius:.6em;padding:.6em 1em;margin-bottom:1vh;font-weight:600}
#toast{position:fixed;bottom:3vh;left:50%;transform:translate(-50%,30px);background:var(--navy);color:#fff;padding:.7em 1.3em;border-radius:2em;opacity:0;transition:.25s;pointer-events:none;z-index:9}#toast.on{opacity:1;transform:translate(-50%,0)}
#login{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:rgba(240,246,255,.92);backdrop-filter:blur(8px)}#login.hide{display:none}
.lcard{background:#fff;border:1px solid var(--line);border-radius:1.2em;padding:2em 2.2em;width:min(380px,92vw);display:flex;flex-direction:column;gap:.8em;box-shadow:0 20px 50px rgba(30,111,224,.18)}
.lcard h2{color:var(--navy)}.lcard p{color:var(--mut)}#lerr{color:var(--bad);font-weight:600;min-height:1.2em}
@media (max-width:820px){.cols,.dash{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.top{flex-wrap:wrap;gap:.6em}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="logo">GEO<b>PRO</b><small>SERVICES</small></div>
    <div class="ttl"><h1>GeoPro EOD Update Tracker</h1><span>Daily Operations Dashboard</span></div>
    <div class="right"><div class="dnav"><button id="dprev" title="Previous day">‹</button><input type="date" id="f_date"><button id="dnext" title="Next day">›</button></div><span id="sync" class="sync wait">Connecting…</span><button id="xl">⬇ Excel</button><button id="edit" class="hide">Edit data</button><button id="out">Sign out</button></div>
  </div>

  <div id="form">
    <div class="hint">Pick any date at the top; its saved data loads here and on the dashboard. <b>Completed</b> defaults to Received, absent counts come from the names, and MTD is always recalculated from all saved days of the month, so editing an earlier date updates every later MTD.</div>
    <div class="cols">
      <div class="sec"><h2>Who is absent today?</h2><div id="f_att"></div></div>
      <div class="sec"><h2>Today's work</h2><div id="f_ws"></div></div>
    </div>
    <div class="sec"><h2>Minutes taken by stage <small style="font-weight:400;color:var(--mut)">(daily averages in minutes; leave a row empty if no cases)</small></h2><div id="f_tat"></div></div>
    <details class="sec"><summary>Headcount, opening month-to-date and alerts (rarely change)</summary><div class="more" id="f_more"></div></details>
    <div class="act"><button id="clear">Clear today</button><button id="go" class="pri">Save &amp; show dashboard →</button></div>
  </div>

  <div id="view" class="hide"></div>
</div>
<div id="toast"></div>
<div id="login"><div class="lcard"><div class="logo">GEO<b>PRO</b><small>SERVICES</small></div><h2>EOD Update Tracker</h2><p>Sign in to continue</p>
<input id="lem" type="email" placeholder="Email" autocomplete="username"><input id="lpw" type="password" placeholder="Password" autocomplete="current-password">
<button id="lgo" class="pri">Sign in</button><div id="lerr"></div></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import {getFirestore,doc,setDoc,getDocs,collection,query,where,onSnapshot,serverTimestamp} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
