/* ============ PASTE YOUR FIREBASE CONFIG HERE (Firebase console > Project settings > Your apps) ============ */
const FIREBASE_CONFIG={apiKey: "AIzaSyC_o7MDzhX1g6LgnmOLgLc4EmMrg-yfQMw",
  authDomain: "eod-tracker-f5382.firebaseapp.com",
  projectId: "eod-tracker-f5382",
  storageBucket: "eod-tracker-f5382.firebasestorage.app",
  messagingSenderId: "984837308854",
  appId: "1:984837308854:web:ddcf624101bebad99d8117"};
/* ============================================================================================================ */
const W=[{id:"VOB",s:["Regular","Re-Verify/Escalations","Internal"]},{id:"BRC",s:["BRC"]},{id:"RCM VOB Requests",s:["Requests"],mtdOn:"received"},
 {id:"MR",s:["MR Queue","Appeal Queue","UHC letters"]},{id:"UR",s:["Concurrent Due Today","Pending","Incoming","Up to Date PPBH/Retro"]},
 { id:"Payment Posting", s:["CC Manual","Regular"] },
 { id:"TPN", s:["Multiplan","Zelis","Naviguard","Clear Health","Reliant Health"], wide:1 }
];
const D=["VOB","Leads","BRC","AR","MR","TPN","QA","PP"];
const $=id=>document.getElementById(id), f=n=>(+n||0).toLocaleString("en-US"), num=v=>Math.max(0,+v||0), q=x=>document.querySelector(x), qa_=x=>document.querySelectorAll(x);
const HEAD=[15,6,6,15,4,3,3,2];
const p2=n=>String(n).padStart(2,"0"),today=()=>{const d=new Date();return d.getFullYear()+"-"+p2(d.getMonth()+1)+"-"+p2(d.getDate())},ym=d=>d.slice(0,7);
const configured=!FIREBASE_CONFIG.apiKey.startsWith("PASTE");
let db,auth;if(configured){const app=initializeApp(FIREBASE_CONFIG);db=getFirestore(app);auth=getAuth(app)}
let cur=today(),days={},opening={},cfg={head:HEAD,thr:25,qa:98},dirty=false,view="form",unsub=[],started=false;
