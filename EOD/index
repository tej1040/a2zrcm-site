const setSync=(s,t)=>{const e=$("sync");e.className="sync "+s;e.textContent=t||({live:"● Live",saving:"Saving…",err:"Offline / error",wait:"Connecting…"})[s]};

$("f_att").innerHTML=D.map((d,i)=>`<div class="fr a"><span class="l">${d}</span><input type="text" placeholder="Names, e.g. Sandeep, Anusha" data-a="${i}"></div>`).join("");
$("f_ws").innerHTML=`<div class="fr w h"><span>Workstream</span><span>Received</span><span>Completed</span><span>Errors</span></div>`+
W.map((g,gi)=>`<div class="wgroup">
${g.s.length>1?`<div class="wgroup-title">${g.id}</div>`:""}
${g.s.map((s,si)=>`<div class="wgroup-row">
<span class="sub" style="${g.s.length>1?"":"padding-left:0;font-weight:800;color:var(--navy)"}">${g.s.length>1?s:g.id}</span>
${["data-r","data-c","data-e"].map(k=>`<input type="number" min="0" placeholder="${k=="data-e"?"0":(k=="data-c"?"= received":"0")}" ${k}="${gi}.${si}">`).join("")}
</div>`).join("")}
</div>`).join("");
$("f_more").innerHTML=`<h4>Headcount (available staff)</h4>`+D.map((d,i)=>`<label>${d}<input type="number" min="0" data-h="${i}"></label>`).join("")+
 `<h4>Opening MTD for this month (only if you start mid-month; otherwise leave blank)</h4>`+
 W.map((g,gi)=>g.s.map((s,si)=>`<label>${g.s.length>1?g.id+" · ":""}${s}<input type="number" min="0" data-m="${gi}.${si}"></label>`).join("")).join("")+
 `<label>Opening leaves<input type="number" min="0" id="f_lbase"></label><h4>Alerts</h4><label>Flag shrinkage ≥ %<input type="number" id="f_thr"></label><label>QA target %<input type="number" id="f_qa"></label>`;

const TR=["Urgent","Priority","Regular","Reverify","Bulk"],TC=["Assignment","Call Hold","Call Handled","After Call Work","Call End to Merge","Time in QA","Avg Total Time"];
$("f_tat").innerHTML=`<div class="tf h"><span>Request type</span>${TC.map(c=>`<span>${c}</span>`).join("")}</div>`+TR.map((r,ri)=>`<div class="tf"><span class="l">${r}</span>${TC.map((c,ci)=>`<input type="number" min="0" step="any" placeholder="–" data-t="${ri}.${ci}">`).join("")}</div>`).join("");
document.addEventListener("paste",e=>{
  const target=e.target;
  if(!target.matches||!target.matches("#f_tat input[data-t]"))return;
  const text=(e.clipboardData||window.clipboardData).getData("text");
  if(!text.includes("\t"))return;          /* single value: normal paste */
  e.preventDefault();
  /* keep leading blank rows/cells; drop only trailing empty lines */
  let lines=text.replace(/\r/g,"").split("\n");
  while(lines.length&&lines[lines.length-1].trim()==="")lines.pop();
  const [sr,sc]=target.dataset.t.split(".").map(Number);
  const clean=v=>{const n=parseFloat(String(v).replace(/[^0-9.\-]/g,""));return isFinite(n)&&String(v).trim()!==""?String(n):""};
  let pos=0;
  lines.forEach(line=>{
    const cells=line.split("\t"), label=cells[0].trim().toLowerCase();
    const ri=TR.findIndex(t=>t.toLowerCase()===label);
    if(ri>=0){                              /* row starts with a request type name: place by name */
      cells.slice(1).forEach((v,c)=>{const el=document.querySelector(`[data-t="${ri}.${c}"]`);if(el)el.value=clean(v)});
      return;
    }
    if(label==="request type"||label==="grand total"||(cells.every(v=>v.trim()===""||isNaN(parseFloat(v)))&&cells.some(v=>v.trim()!==""))){return}  /* header / total / text-only rows */
    cells.forEach((v,c)=>{const r=sr+pos,cc=sc+c;if(r<TR.length&&cc<TC.length){const el=document.querySelector(`[data-t="${r}.${cc}"]`);if(el)el.value=clean(v)}});
    pos++;
  });
  dirty=true;
},true);
function hints(){qa_("[data-r]").forEach(e=>{const c=q(`[data-c="${e.dataset.r}"]`);c.placeholder=e.value?e.value:"= received"})}
function parseEntry(e,fallbackHead){e=e||{};const head=e.head||fallbackHead||cfg.head;
  const att=D.map((_,i)=>{const n=String(e.names?.[i]||"").trim(),dig=/^\d+$/.test(n),c=dig?+n:(n?n.split(/[,;&]+/).map(x=>x.trim()).filter(Boolean).length:0);return[num(head[i]),c,c,c,0,dig?"":n]});
  const ws=W.map((g,gi)=>g.s.map((_,si)=>{const x=e.ws?.[gi]?.[si]||[],r=num(x[0]),c=(x[1]===""||x[1]==null)?r:num(x[1]);return[r,c,num(x[2]),0]}));
  const tat=TR.map((_,r)=>TC.map((_,c)=>Math.max(0,parseFloat(e.tat?.[r]?.[c])||0)));
  return{att,ws,tat}}
/* MTD is never stored: it is recalculated from every saved day of the month up to the chosen date (+ optional opening balance) */
function model(dt,dm=days,op=opening){
  const e=dm[dt]?JSON.parse(dm[dt].json):null,p=parseEntry(e),o=op&&op.json?JSON.parse(op.json):{};
  const mtd=W.map((g,gi)=>g.s.map((_,si)=>num(o.mtd?.[gi]?.[si]))); let leaves=num(o.leaves);
  Object.keys(dm).filter(k=>k<=dt&&ym(k)===ym(dt)).forEach(k=>{const x=parseEntry(JSON.parse(dm[k].json));
    x.ws.forEach((g,gi)=>g.forEach((v,si)=>{mtd[gi][si]+=v[W[gi].mtdOn==="received"?0:1]}));leaves+=x.att.reduce((t,a)=>t+a[1],0)});
  p.ws.forEach((g,gi)=>g.forEach((x,si)=>x[3]=mtd[gi][si]));
  return{date:dt,has:!!e,leaves,thr:cfg.thr,qa:cfg.qa,att:p.att,ws:p.ws,tat:p.tat}}
function fillForm(dt){const e=days[dt]?JSON.parse(days[dt].json):null,o=opening.json?JSON.parse(opening.json):{};
  $("f_date").value=dt;
  qa_("[data-a]").forEach(x=>x.value=e?.names?.[x.dataset.a]||"");
  ["r","c","e"].forEach((k,j)=>qa_(`[data-${k}]`).forEach(x=>{const[g,s]=x.dataset[k].split(".");x.value=e?.ws?.[g]?.[s]?.[j]??""}));
  qa_("[data-t]").forEach(x=>{const[r,c]=x.dataset.t.split(".");x.value=e?.tat?.[r]?.[c]??""});
  qa_("[data-h]").forEach(x=>x.value=(e?.head||cfg.head)[x.dataset.h]);
  qa_("[data-m]").forEach(x=>{const[g,s]=x.dataset.m.split(".");x.value=o.mtd?.[g]?.[s]||""});
  $("f_lbase").value=o.leaves||"";$("f_thr").value=cfg.thr;$("f_qa").value=cfg.qa;hints();dirty=false}
function readForm(){const names=D.map((_,i)=>q(`[data-a="${i}"]`).value.trim()),head=D.map((_,i)=>num(q(`[data-h="${i}"]`).value));
  const ws=W.map((g,gi)=>g.s.map((_,si)=>["r","c","e"].map(k=>q(`[data-${k}="${gi}.${si}"]`).value)));
  const tat=TR.map((_,r)=>TC.map((_,c)=>q(`[data-t="${r}.${c}"]`).value));
  const mtd=W.map((g,gi)=>g.s.map((_,si)=>num(q(`[data-m="${gi}.${si}"]`).value)));
  return{entry:{names,head,ws,tat},open:{mtd,leaves:num($("f_lbase").value)},thr:num($("f_thr").value),qa:num($("f_qa").value)}}

/* dashboard */
const mm=n=>n?String(Math.round(n*100)/100):"–";
function tatHtml(d){const T=d.tat||[],vis=TR.map((_,i)=>i).filter(i=>(T[i]||[]).some(v=>v>0));
  if(!vis.length)return"";
  const tot=TC.map((_,c)=>vis.reduce((t,i)=>t+(T[i][c]||0),0));
  return `<section class="tat"><h3>Minutes taken by stage and average TAT</h3><div class="tg"><div class="h n">Request type</div>${TC.map(c=>`<div class="h">${c}</div>`).join("")}${vis.map(i=>`<div class="n">${TR[i]}</div>${TC.map((_,c)=>`<div class="${T[i][c]?"":"z"}${c==6?" lc":""}">${mm(T[i][c])}</div>`).join("")}`).join("")}<div class="n tot">Grand Total</div>${tot.map(v=>`<div class="tot">${mm(v)}</div>`).join("")}</div></section>`}
function render(d){
  const cards=W.map((g,gi)=>{
    const r=d.ws[gi],rec=r.reduce((t,x)=>t+x[0],0),comp=r.reduce((t,x)=>t+x[1],0),err=r.reduce((t,x)=>t+x[2],0),mtd=r.reduce((t,x)=>t+x[3],0),
      pend=r.reduce((t,x)=>t+Math.max(0,x[0]-x[1]),0),
      st=pend>0&&comp===0?"Pending":(pend>0||err>0?"Issue":"Completed"),qa=comp?Math.max(0,(comp-err)/comp):1;
    const flags=(pend?`<span class="flag p">${pend} pending</span>`:"")+(err?`<span class="flag e">${err} errors · QA ${(qa*100).toFixed(1)}%</span>`:"");
    const subs=g.s.length>1?`<ul>${g.s.map((s,si)=>{const x=r[si],z=!x[0]&&!x[1];
      return `<li class="${z?"z":""}"><span>${s}</span><span>${z?"–":f(x[1])+(x[0]!==x[1]?" / "+f(x[0]):"")}<small>${f(x[3])}</small></span></li>`}).join("")}</ul>`:"";
    return `<section class="card ${st} ${g.wide?"tpn":""}"><header><h3>${g.id}</h3><span class="chip">${st}</span></header>
     <div class="big"><div><b>${f(comp)}</b><em>of ${f(rec)} done</em></div><div class="mtd">MTD${g.mtdOn?" (received)":""}<b>${f(mtd)}</b></div></div>
     ${rec?`<div class="bar"><i style="width:${Math.min(100,comp/rec*100)}%"></i></div>`:""}
     ${flags?`<div>${flags}</div>`:""}${subs}</section>`}).join("");
  const tot=d.att.reduce((t,x)=>t+x[0],0),abs=d.att.reduce((t,x)=>t+x[1],0);
  const att=`<aside class="att"><h3>Attendance</h3><div class="sum"><b>${abs}</b> <span>of ${tot} absent · ${tot?Math.round(abs/tot*100):0}%</span></div>
   ${d.att.map((x,i)=>{const sh=x[0]?x[1]/x[0]:0,tag="";
    return `<div class="d ${x[1]?"":"z"}"><div><b>${D[i]}</b>${x[1]?`<span class="pill ${sh*100>=d.thr?"hi":""}">${x[1]} / ${x[0]} · ${Math.round(sh*100)}%</span>`:`<span>${x[0]||"–"}</span>`}</div>
    ${x[1]&&(x[5]||tag)?`<div class="n"><span>${x[5]}</span><span>${tag}</span></div>`:""}</div>`}).join("")}
   <div class="foot"><span>Total leaves to date</span><b>${f(d.leaves)}</b></div></aside>`;
  $("view").innerHTML=`${d.has?"":`<div class="empty">No data saved for ${d.date} yet. Click Edit data to enter it.</div>`}<div class="dash"><div class="grid">${cards}</div>${att}</div>${tatHtml(d)}`;
}
function show(v){view=v?"dash":"form";$("form").classList.toggle("hide",v);$("view").classList.toggle("hide",!v);$("edit").classList.toggle("hide",!v);document.body.classList.toggle("dm",v);document.body.style.overflow="auto"}
function paint(){if(!dirty)fillForm(cur);if(view==="dash")render(model(cur))}
function sub(){unsub.forEach(u=>u());unsub=[];days={};opening={};const m=ym(cur);
  unsub.push(onSnapshot(query(collection(db,"eod"),where("date",">=",m+"-01"),where("date","<=",m+"-31")),s=>{days={};s.forEach(x=>days[x.id]=x.data());setSync("live");paint()},()=>setSync("err")));
  unsub.push(onSnapshot(doc(db,"months",m),s=>{opening=s.exists()?s.data():{};paint()},()=>setSync("err")));
  unsub.push(onSnapshot(doc(db,"settings","main"),s=>{cfg=Object.assign({head:HEAD,thr:25,qa:98},s.data()||{});paint()},()=>setSync("err")))}
function setDate(dt){if(!dt||dt===cur){$("f_date").value=cur;return}
  if(dirty&&!confirm("You have unsaved changes for "+cur+". Discard them?")){$("f_date").value=cur;return}
  const nm=ym(dt)!==ym(cur);cur=dt;dirty=false;$("f_date").value=dt;if(nm)sub();else paint()}
const shift=n=>{const d=new Date(cur+"T00:00:00");d.setDate(d.getDate()+n);setDate(d.getFullYear()+"-"+p2(d.getMonth()+1)+"-"+p2(d.getDate()))};
$("go").onclick=async()=>{const r=readForm(),dt=cur;setSync("saving");
  try{const w=Promise.all([setDoc(doc(db,"eod",dt),{date:dt,json:JSON.stringify(r.entry),by:auth.currentUser?.email||"",at:serverTimestamp()}),
    setDoc(doc(db,"settings","main"),{head:r.entry.head,thr:r.thr,qa:r.qa},{merge:true}),
    setDoc(doc(db,"months",ym(dt)),{json:JSON.stringify(r.open)})]);
    await Promise.race([w,new Promise(x=>setTimeout(x,2500))]);dirty=false;toast("Saved ✓  MTD recalculated");show(true);paint();setSync("live")}
  catch(e){setSync("err");alert("Could not save: "+(e.code||e.message))}};
$("edit").onclick=()=>show(false);
$("f_date").onchange=()=>setDate($("f_date").value);$("dprev").onclick=()=>shift(-1);$("dnext").onclick=()=>shift(1);
$("form").addEventListener("input",()=>{hints();dirty=true});
$("form").addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.tagName==="INPUT"){e.preventDefault();const a=[...qa_("#form input")];const n=a[a.indexOf(e.target)+1];if(n)n.focus()}});
$("clear").onclick=()=>{qa_("[data-a],[data-r],[data-c],[data-e],[data-t]").forEach(x=>x.value="");hints();dirty=true};
window.addEventListener("beforeunload",e=>{if(dirty){e.preventDefault();e.returnValue=""}});
/* ---- Excel export of every saved day ---- */
const sheet=(rows,pc,w)=>{const s=XLSX.utils.aoa_to_sheet(rows);rows.forEach((r,i)=>{if(i)pc.forEach(c=>{const a=XLSX.utils.encode_cell({r:i,c});if(s[a])s[a].z="0.0%"})});s["!cols"]=w.map(x=>({wch:x}));return s};
async function exportXL(){
  if(typeof XLSX==="undefined"){alert("The Excel library did not load. Check your internet connection and reload the page.");return}
  let all={},ops={};
  try{const[es,ms]=await Promise.all([getDocs(collection(db,"eod")),getDocs(collection(db,"months"))]);es.forEach(x=>all[x.id]=x.data());ms.forEach(x=>ops[x.id]=x.data())}
  catch(e){alert("Could not read data: "+(e.code||e.message));return}
  const ds=Object.keys(all).sort();if(!ds.length){alert("No saved days yet.");return}
  const H={};ds.forEach(d=>H[d]=model(d,all,ops[ym(d)]||{}));
  const wr=[["Date","Workstream","Type","Received","Completed","Pending","Errors","QA %","MTD"]],
    ar=[["Date","Department","Available","Absent","Shrinkage %","On leave"]],
    sm=[["Date","Staff available","Absent","Shrinkage %","Leaves to date","Received","Completed","Pending","Errors","QA %"]];
  ds.forEach(d=>{const h=H[d];let R=0,C=0,E=0,P=0,av=0,ab=0;
    W.forEach((g,gi)=>g.s.forEach((t,si)=>{const x=h.ws[gi][si],pe=Math.max(0,x[0]-x[1]);R+=x[0];C+=x[1];E+=x[2];P+=pe;
      wr.push([d,g.id,g.s.length>1?t:"",x[0],x[1],pe,x[2],x[1]?Math.max(0,(x[1]-x[2])/x[1]):1,x[3]])}));
    h.att.forEach((a,i)=>{av+=a[0];ab+=a[1];ar.push([d,D[i],a[0],a[1],a[0]?a[1]/a[0]:0,a[5]])});
    sm.push([d,av,ab,av?ab/av:0,h.leaves,R,C,P,E,C?Math.max(0,(C-E)/C):1])});
  const tr=[["Date","Request Type",...TC.map(c=>c==="Avg Total Time"?"Avg Total Time (min)":c+" (min)")]];
  ds.forEach(d=>{const T=H[d].tat||[],vis=TR.map((_,i)=>i).filter(i=>(T[i]||[]).some(v=>v>0));
    vis.forEach(i=>tr.push([d,TR[i],...T[i]]));
    if(vis.length)tr.push([d,"Grand Total",...TC.map((_,c)=>Math.round(vis.reduce((t,i)=>t+T[i][c],0)*100)/100)])});
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,sheet(sm,[3,9],[12,14,9,12,14,10,11,9,8,8]),"Daily Summary");
  XLSX.utils.book_append_sheet(wb,sheet(wr,[7],[12,20,22,10,11,9,8,8,10]),"Workstreams");
  XLSX.utils.book_append_sheet(wb,sheet(ar,[4],[12,12,10,9,12,28]),"Attendance");
  if(tr.length>1)XLSX.utils.book_append_sheet(wb,sheet(tr,[],[12,14,16,16,16,18,20,14,20]),"Minutes by Stage");
  const blob=new Blob([XLSX.write(wb,{bookType:"xlsx",type:"array"})]);
  const fn="GeoPro_EOD_Data_"+today()+".xlsx";
  let dl=null;try{dl=await window.claude?.use("downloads")}catch(e){}
  if(!dl){XLSX.writeFile(wb,fn);return}   /* opened as a normal file in Chrome: plain browser download */
  try{await dl.save({filename:fn,data:blob})}
  catch(e){if(e&&e.code!=="declined")alert("Could not save the Excel file ("+(e.code||e.message||"error")+").")}
}
$("xl").onclick=exportXL;
$("out").onclick=()=>signOut(auth);
$("lgo").onclick=async()=>{$("lerr").textContent="";try{await signInWithEmailAndPassword(auth,$("lem").value.trim(),$("lpw").value)}catch(e){$("lerr").textContent="Sign-in failed ("+(e.code||e.message)+")"}};
$("lpw").addEventListener("keydown",e=>{if(e.key==="Enter")$("lgo").click()});
show(false);$("f_date").value=cur;hints();
if(!configured){$("lerr").textContent="Firebase is not configured yet: paste your config at the top of the script (see setup guide).";$("lgo").disabled=true}
else onAuthStateChanged(auth,u=>{if(u){$("login").classList.add("hide");if(!started){started=true;sub()}}else{unsub.forEach(x=>x());unsub=[];started=false;$("login").classList.remove("hide")}});
</script>
